[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/test_area.tscn" id="2_test_area"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="3_player"]
[ext_resource type="Script" path="res://scripts/game_calendar.gd" id="4_calendar"]
[ext_resource type="Script" path="res://scripts/season_system.gd" id="5_season"]

[node name="Main" type="Node"]
script = ExtResource("1_main")

[node name="GameCalendar" type="Node" parent="." groups=["game_calendar"]]
script = ExtResource("4_calendar")

[node name="SeasonSystem" type="Node" parent="." groups=["season_system"]]
script = ExtResource("5_season")
calendar_path = NodePath("../GameCalendar")

[node name="AreaContainer" type="Node2D" parent="."]

[node name="TestArea" parent="AreaContainer" instance=ExtResource("2_test_area")]

[node name="Player" parent="." instance=ExtResource("3_player")]
